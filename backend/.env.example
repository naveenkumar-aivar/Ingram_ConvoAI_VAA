# Copy this to .env and adjust. The defaults run the app with local storage
# and a mock LLM (no AWS, no API keys needed).

# --- Modes ------------------------------------------------------------------
# MOCK_MODE controls STORAGE only:
#   true  = read/write context packs in the local s3-data folder (no AWS)
#   false = read/write real Amazon S3
MOCK_MODE=true

# LLM_PROVIDER controls where chat answers AND the evaluator come from:
#   mock    = canned demo text (no LLM)
#   bedrock = real LLM via Strands + Amazon Bedrock
LLM_PROVIDER=mock

# --- AWS (only used when MOCK_MODE=false or LLM_PROVIDER=bedrock) ------------
AWS_REGION=us-east-1
# Credentials are read by boto3 from the standard chain (env vars, ~/.aws,
# SSO, instance role) — you usually do NOT set keys here.
#
# BEDROCK_MODEL_ID: copy the EXACT id from AWS console -> Bedrock -> Model
# access. Bedrock rejects guessed ids. It is often an inference-profile id
# prefixed like "us." (e.g. us.anthropic.claude-...).
BEDROCK_MODEL_ID=CONFIRM_IN_CONSOLE

# --- Storage ----------------------------------------------------------------
S3_BUCKET=vertical-adaption-agent
CONTEXT_PACK_PREFIX=context-pack/
INDUSTRY_DOCS_PREFIX=industry-docs/
LOCAL_S3_DIR=../s3-data

# --- Server -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed by CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173
