
# Storage: switch to AWS S3
MOCK_MODE=false  # Set to true to use local s3-data folder instead

# LLM provider: mock | bedrock
LLM_PROVIDER=bedrock 

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Storage ----------------------------------------------------------------
S3_BUCKET=vertical-adaption-agent
CONTEXT_PACK_PREFIX=context-pack/
INDUSTRY_DOCS_PREFIX=industry-docs/
LOCAL_S3_DIR=../s3-data
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
